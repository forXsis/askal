use console;

class Point {
    var int64 x = 0;
    var int64 y = 0;

    fun init(int64 x0, int64 y0) {
        x = x0;
        y = y0;
        return null;
    }

    fun translate(int64 dx, int64 dy) {
        x = x + dx;
        y = y + dy;
        return null;
    }

    fun length_sq() -> int64 {
        return x * x + y * y;
    }

    fun print() {
        console >> print("Point(");
        console >> print_int(x);
        console >> print(", ");
        console >> print_int(y);
        console >> println(")");
        return null;
    }
}

fun main() {
    var Point p1 = Point(3, 4);
    var Point p2 = Point(-2, 5);

    p1 >> print();
    p2 >> print();

    console >> print("len_sq(p1) = ");
    console >> print_int(p1 >> length_sq());
    console >> println("");

    p1 >> translate(10, 10);
    p1 >> print();

    console >> print("len_sq(p1) after = ");
    console >> print_int(p1 >> length_sq());
    console >> println("");

    p1 >> free();
    p2 >> free();

    return null;
}

main();
